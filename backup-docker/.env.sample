# ../setup.py backup writes this file for you. To do it by hand, copy this file
# to .env and fill it in.

# Your Dropbox app's key and secret (its Settings tab at https://www.dropbox.com/developers/apps)
APP_KEY=
APP_SECRET=
# From linking Dropbox to the app; ../setup.py backup gets it
DROPBOX_REFRESH_TOKEN=

# BACKUP uploads WATCH_FOLDER to DROPBOX_FOLDER; RESTORE downloads DROPBOX_FOLDER into WATCH_FOLDER
SYNC_DIRECTION=BACKUP
# The folder on this machine. Docker mounts it into the container as /backup;
# the systemd service uses it directly.
WATCH_FOLDER=/srv/data
# The Dropbox folder: a path like /Backups/server1, or ns:<id> for a team folder or a
# shared folder that isn't added to your Dropbox (../setup.py shared lists them)
DROPBOX_FOLDER=/Backups/server1
# Seconds between passes
SLEEP_TIME=300

# Optional: more detail in the logs, and a log file besides stderr
# DEBUG_LEVEL=DEBUG
# LOG_FILE=/var/log/dropbox-backup.log
