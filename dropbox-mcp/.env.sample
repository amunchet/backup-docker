# ../setup.py mcp writes this file for you. To do it by hand, copy this file to
# .env and fill it in.

# Your Dropbox app's key and secret (its Settings tab at https://www.dropbox.com/developers/apps)
APP_KEY=
APP_SECRET=
# From linking Dropbox to the app; ../setup.py mcp gets it
DROPBOX_REFRESH_TOKEN=

# Comma-separated folders (or files) MCP clients may write to; everything else is
# read-only. Use a path in your Dropbox, or ns:<shared_folder_id> for a shared
# folder that isn't added to it. Empty means nothing is writable.
WRITABLE_PATHS=
# Auth0 permission (via caddy-auth0) a caller needs to write
WRITE_PERMISSION=dropbox:write

# Dropbox Business: browse from the team's root, so team folders are at the top level
DROPBOX_TEAM_SPACE=false

# The public hostname; only ../setup.py uses it, to print the Caddy and client settings
MCP_HOST=

# Optional: largest file read_file returns, in bytes, and most entries list_folder returns
# MAX_READ_BYTES=10485760
# LIST_LIMIT=2000
