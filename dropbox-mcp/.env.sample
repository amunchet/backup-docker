# Dropbox App information (a "Full Dropbox" app; see README)
APP_KEY=XXXXXXXX
APP_SECRET=XXXXXXXX
REDIRECT_URI=XXXXXXX

# Paste the Dropbox refresh token here, from `../backup-docker/obtain_refresh_token2.py`
DROPBOX_REFRESH_TOKEN=XXXXXXXX

# Comma-separated folders that may be written to. Everything else is read-only.
# Use a path in your Dropbox, or ns:<shared_folder_id> for a shared folder that
# isn't added to it. Empty means nothing is writable.
WRITABLE_PATHS=

# Permission (from caddy-auth0 / Auth0 RBAC) a caller needs to write.
WRITE_PERMISSION=dropbox:write

# Dropbox Business: browse from the team root, so team folders are at the top level.
DROPBOX_TEAM_SPACE=false

# Largest file read_file will return, in bytes, and the most entries list_folder returns.
MAX_READ_BYTES=10485760
LIST_LIMIT=2000
